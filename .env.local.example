# Copy this file to .env.local and fill in the values from
# Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed if you later add server-side admin actions (e.g. inviting staff
# via the Supabase Admin API from an API route). NEVER expose this to the
# browser / never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
